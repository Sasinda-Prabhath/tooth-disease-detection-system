*.pt
*.pth
*.onnx
*.tflite
*.h5
*.keras
*.ckpt
*.safetensors

# Private/raw OPG images, DICOM files, and generated training data
# Keep only the .gitkeep placeholders and documentation in these directories.
services/module2-impaction-boneloss/training/data/raw/**
!services/module2-impaction-boneloss/training/data/raw/.gitkeep
services/module2-impaction-boneloss/training/data/processed/**
!services/module2-impaction-boneloss/training/data/processed/.gitkeep
!services/module2-impaction-boneloss/training/data/processed/segmentation_masks/
!services/module2-impaction-boneloss/training/data/processed/segmentation_masks/.gitkeep
services/module2-impaction-boneloss/training/data/yolo/**
!services/module2-impaction-boneloss/training/data/yolo/.gitkeep

# Local annotations can contain patient-linked metadata. Commit only an explicitly
# approved template/example, never an export from a real clinical dataset.
services/module2-impaction-boneloss/training/data/annotations/*.json
!services/module2-impaction-boneloss/training/data/annotations/.gitkeep

# Imaging exports produced outside the controlled training-data directories
*.dcm
*.dicom

# Local service state, temporary uploads, and database files
uploads/
tmp/
temp/
*.pid
*.sqlite
*.sqlite3
*.db
postgres-data/
docker-compose.override.yml
